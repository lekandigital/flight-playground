<?xml version="1.0"?>

<!--
************************************************************************
YASim aerodynamic model for daVinci_Bf-109G10

************************************************************************
-->

<!-- Weight of everything but fuel -->
<airplane mass="5090" version="YASIM_VERSION_CURRENT">

<!-- Approach configuration -->
<approach speed="72" aoa="8">
<control-setting axis="/controls/engines/engine[0]/throttle" value="0.3"/>
<control-setting axis="/controls/engines/engine[0]/mixture" value="0.6"/>
<control-setting axis="/controls/engines/engine[0]/propeller-pitch" value="0.1"/>
<control-setting axis="/controls/flight/flaps" value="1.0"/>
<control-setting axis="/controls/gear/gear-down" value="1"/>
</approach>

<!-- Cruise configuration -->
<cruise speed="244" alt="24000">
<control-setting axis="/controls/engines/engine[0]/throttle" value="1.00"/>
<control-setting axis="/controls/engines/engine[0]/mixture" value="0.42"/>
<control-setting axis="/controls/engines/engine[0]/propeller-pitch" value="1.0"/>
<control-setting axis="/controls/engines/engine[0]/boost" value="1.7"/>
<control-setting axis="/controls/flight/flaps" value="0.0"/>
<control-setting axis="/controls/gear/gear-down" value="0"/>
</cruise>

<!-- pilot's eyepoint -->
<cockpit x="-3.8" y="0" z="0.6"/>

<fuselage ax="-0.4" ay="0.0" az="0.12" bx="-1.0" by="0.0" bz="0.12"
width="0.6" taper="0.2" midpoint="1.0" idrag="0.2"/>
<fuselage ax="-1.0" ay="0.0" az="0.12" bx="-1.7" by="0.0" bz="0.0"
width="1.1" taper="0.7" midpoint="1.0" idrag="0.2"/>
<fuselage ax="-1.7" ay="0.0" az="-0.04" bx="-3.8" by="0.0" bz="-0.1"
width="1.3" taper="0.9" midpoint="1.0" idrag="0.2"/>
<fuselage ax="-4.0" ay="0.0" az="-0.04" bx="-4.5" by="0.0" bz="0.1"
width="1.55" taper="0.9" midpoint="1.0" idrag="0.2"/>
<fuselage ax="-4.5" ay="0.0" az="0.1" bx="-9.0" by="0.0" bz="0.15"
width="1.55" taper="0.4" midpoint="0.0" idrag="0.2"/>

<!-- inner wing -->
<wing x="-3.866" y="0.422" z="-0.410" taper="0.877" incidence="2.0"
length="2.366" chord="2.48" sweep="-1.7" dihedral="5" camber="0.05">
<stall aoa="11" width="8" peak="2.0"/>
<flap0 start="0.0" end="1.0" lift="1.9" drag="2.3"/>
<control-input axis="/controls/flight/flaps" control="FLAP0"/>
<control-output control="FLAP0" prop="/surface-positions/flap-pos-norm"/>
<control-speed control="FLAP0" transition-time="20"/>
</wing>

<!-- outer wing -->
<mstab x="-3.642" y="3.513" z="-0.159" taper="0.66" incidence="2.0" twist="0.5" effectiveness = "1.0"
length="1.845" chord="2.176" sweep="-4.0" dihedral="5" camber="0.05" >
<stall aoa="11" width="11" peak="2.0"/>
<flap0 start="0.0" end="1.0" lift="2.1" drag="1.20"/>
<control-input axis="/controls/flight/aileron" control="FLAP0" split="true"/>
<control-input axis="/controls/flight/aileron-trim" control="FLAP0" split="true"/>
<control-input axis="/controls/flight/aileron-effectiveness" control="FLAP0EFFECTIVENESS" 
src0="0" src1="1" dst0="0" dst1="1"/>
<control-speed control="FLAP0" transition-time="0.600"/>
</mstab>

<!-- normal wingtip -->
<mstab x="-3.441" y="4.632" z="-0.166" taper="0.2" incidence="-0.0"
length="0.992" chord="1.431" sweep="-7.7" dihedral="5" camber="0.1">
<stall aoa="12" width="8" peak="1.5"/>
</mstab>

<!-- elevator -->
<hstab x="-8.581" y="0.14" z="0.465" taper="0.5" incidence="2.0"
length="1.5" chord="1.4" sweep="7">
<stall aoa="19" width="10.5" peak="3.0"/>
<flap0 start="0.0" end="1.0" lift="2.473" drag="1.5"/>
<control-input axis="/controls/flight/elevator" control="FLAP0"/>
<control-input axis="/controls/flight/elevator-trim" control="FLAP0"/>
<control-input axis="/controls/flight/slipstream" control="SLAT"/>
<control-output control="FLAP0" prop="/surface-positions/elevator-pos-norm"/>
<control-speed control="FLAP0" transition-time="0.600"/>
</hstab>

<!-- rudder -->
<vstab x="-8.70" y="0" z="0.490" taper="0.4" 
length="1.5" chord="1.7" sweep="13">
<stall aoa="15" width="8" peak="3.5"/> 
<flap0 start="0" end="1" lift="3.0" drag="3.0"/>
<control-input axis="/controls/flight/rudder" control="FLAP0" invert="true"/>
<control-input axis="/controls/flight/rudder-trim" control="FLAP0" invert="true"/>
<control-output control="FLAP0" prop="/surface-positions/rudder-pos-norm"
min="1" max="-1"/>
<control-speed control="FLAP0" transition-time="0.300"/>
</vstab>


<propeller x="-0.729" y="0" z="-0.043"
radius="1.4" 
mass="1575" moment="74.5"
cruise-alt="10800" cruise-power="1160"
cruise-speed="340" cruise-rpm="1257" fine-stop="0.545" coarse-stop="4.0"
gear-ratio="0.479"
min-rpm="862" max-rpm="1437" >
<actionpt x="-0.85" y="0" z="0.126"/>
<control-input axis="/controls/engines/engine[0]/propeller-pitch" control="ADVANCE" />
<piston-engine
eng-power="1960" eng-rpm="3000" supercharger="1"
turbo-mul="3.2" wastegate-mp="61"
>
<control-input axis="/controls/engines/engine[0]/throttle" control="THROTTLE"/>
<control-input axis="/controls/engines/engine[0]/starter" control="STARTER"/>
<control-input axis="/controls/engines/engine[0]/magnetos" control="MAGNETOS"/>
<control-input axis="/controls/engines/engine[0]/mixture" control="MIXTURE"/>
<control-input axis="/controls/engines/engine[0]/boost" control="BOOST"/>
<control-speed control="THROTTLE" transition-time="1.500"/>
</piston-engine>

</propeller>


<!-- left main -->
<gear x="-2.804" y="1.840" z="-1.748" compression="0.15" spring="0.2" damp="12.3" 
dfric="0.58" sfric="0.5" stiction="1"
>
<control-input axis="/controls/gear/brake-left" control="BRAKE"/>
<control-input axis="/controls/gear/brake-parking" control="BRAKE" split="true"/>
<control-input axis="/controls/gear/gear-down" control="EXTEND"/>
<control-speed control="EXTEND" transition-time="6.5"/>
<control-output control="EXTEND" prop="/gear/gear[0]/position-norm"/>
</gear>

<!-- right main -->
<gear x="-2.804" y="-1.840" z="-1.748" compression="0.15" spring="0.2" damp="12.3"
dfric="0.58" sfric="0.5" stiction="1"
>
<control-input axis="/controls/gear/brake-right" control="BRAKE"/>
<control-input axis="/controls/gear/brake-parking" control="BRAKE" split="true"/>
<control-input axis="/controls/gear/gear-down" control="EXTEND"/>
<control-speed control="EXTEND" transition-time="8"/>
<control-output control="EXTEND" prop="/gear/gear[1]/position-norm"/>
</gear>

<!-- Tail wheel -->
<!-- tail wheel "steerable" in this version (in stick back locked position it actually should be limited to 6deg +/-) -->
<gear x="-7.670" y="0" z="-0.480" compression="0.2" dfric="0.75" sfric="0.5" stiction="1" >
<control-input axis="/controls/gear/brake-parking" control="BRAKE" split="true"/>
<control-input axis="/controls/flight/rudder" control="STEER" square="true" 
src0="-1.0" src1="1.0"
dst0="0.5" dst1="-0.5"/>
<control-input axis="/controls/gear/tailwheel-lock" control="CASTERING" 
src0="0" src1="1"
dst0="1" dst1="0"/>
<control-input axis="/controls/gear/gear-down" control="EXTEND"/>
<control-speed control="EXTEND" transition-time="4"/>
<control-output control="EXTEND" prop="/gear/gear[2]/position-norm"/>
</gear>

<tank x="-3.40" y="0" z="0.25" capacity="1475"/> 

<!-- Balancing Ballast -->


<ballast x="-4.5" y="0" z="0.5" mass="180"/>

<ballast x="-7.670" y="0" z="0.645" mass="400"/>

<ballast x="-3.3" y="1.3" z="0.4" mass="-200"/>

<ballast x="-3.3" y="-1.3" z="0.4" mass="-200"/>

</airplane>